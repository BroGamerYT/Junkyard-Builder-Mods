      <Private>false</Private>
    </Reference>

    <!-- Unity and IL2CPP Game references -->
    <Reference Include="Assembly-CSharp">
      <HintPath>E:\Games\Steam\steamapps\common\Junkyard Builder\MelonLoader\Il2CppAssemblies\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
